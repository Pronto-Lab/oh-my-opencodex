{
  "name": "oh-my-codex",
  "version": "1.0.0-alpha.0",
  "description": "The Best AI Agent Harness - Batteries-Included Codex Enhancement with Multi-Agent Orchestration, Parallel Background Threads, and Crafted LSP/AST Tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "oh-my-codex": "./bin/oh-my-codex.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun --format esm --external @ast-grep/napi && bun build src/cli/index.ts --outdir dist/cli --target bun --format esm --external @ast-grep/napi && tsc --emitDeclarationOnly",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": [
    "codex",
    "openai",
    "agents",
    "ai",
    "llm",
    "mcp"
  ],
  "author": "YeonGyu-Kim",
  "license": "SUL-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-yeongyu/oh-my-opencodex.git"
  },
  "bugs": {
    "url": "https://github.com/code-yeongyu/oh-my-opencodex/issues"
  },
  "homepage": "https://github.com/code-yeongyu/oh-my-opencodex#readme",
  "dependencies": {
    "@ast-grep/cli": "^0.40.0",
    "@ast-grep/napi": "^0.40.0",
    "@clack/prompts": "^0.11.0",
    "@code-yeongyu/comment-checker": "^0.6.1",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@openai/codex-sdk": "^0.104.0",
    "commander": "^14.0.2",
    "detect-libc": "^2.0.0",
    "js-yaml": "^4.1.1",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.2",
    "vscode-jsonrpc": "^8.2.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/picomatch": "^3.0.2",
    "bun-types": "1.3.6",
    "typescript": "^5.7.3"
  },
  "trustedDependencies": [
    "@ast-grep/cli",
    "@ast-grep/napi",
    "@code-yeongyu/comment-checker"
  ]
}
