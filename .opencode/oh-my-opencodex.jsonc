{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.2",
      "reasoningEffort": "high"
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.3-codex",
      "reasoningEffort": "medium"
    },
    "hephaestus": {
      "model": "openai/gpt-5.3-codex",
      "variant": "medium"
    },
    "atlas": {
      "model": "openai/gpt-5.2",
      "reasoningEffort": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.2",
      "reasoningEffort": "high"
    },
    "momus": {
      "model": "openai/gpt-5.2",
      "reasoningEffort": "medium"
    },
    "explore": {
      "model": "openai/gpt-5-nano"
    },
    "librarian": {
      "model": "openai/gpt-5.2"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.2"
    },
    "prometheus": {
      "model": "openai/gpt-5.2",
      "reasoningEffort": "high"
    },
    "metis": {
      "model": "openai/gpt-5.2",
      "reasoningEffort": "high"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "openai/gpt-5.2",
      "reasoningEffort": "medium"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.3-codex",
      "variant": "xhigh"
    },
    "deep": {
      "model": "openai/gpt-5.3-codex",
      "variant": "medium"
    },
    "artistry": {
      "model": "openai/gpt-5.2",
      "reasoningEffort": "medium"
    },
    "quick": {
      "model": "openai/gpt-5-nano"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.2"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.3-codex",
      "variant": "high"
    },
    "writing": {
      "model": "openai/gpt-5.2",
      "textVerbosity": "high"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "openai": 6
    },
    "modelConcurrency": {
      "openai/gpt-5.3-codex": 2,
      "openai/gpt-5.2": 4,
      "openai/gpt-5-nano": 12
    }
  },
  "experimental": {
    "task_system": true,
    "preemptive_compaction": true
  }
}
